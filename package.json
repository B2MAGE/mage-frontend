{
  "name": "mage-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "engine:prepare": "patch-package --error-on-fail && node node_modules/@notrac/mage/dist/build-compiler.mjs",
    "prebuild": "npm run engine:prepare && npm run icons:generate",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "postinstall": "npm run engine:prepare",
    "pretest": "npm run engine:prepare && npm run test:isolation-security && npm run worker-check:test",
    "test": "vitest run",
    "test:isolation-security": "node --test scripts/isolated-security-imports.test.mjs scripts/isolated-security-server.test.mjs scripts/isolated-security-probes.test.mjs scripts/isolated-security-report.test.mjs",
    "preview": "vite preview",
    "prerenderer:build": "npm run engine:prepare",
    "renderer:build": "tsc -b && node scripts/build-isolated-renderer.mjs",
    "prerenderer:build:production": "npm run engine:prepare",
    "renderer:build:production": "tsc -b && node scripts/build-isolated-renderer.mjs --production",
    "renderer:serve": "node scripts/serve-isolated-renderer.mjs",
    "renderer:verify": "node scripts/verify-isolated-renderer.mjs",
    "renderer:verify:production": "node scripts/verify-isolated-renderer.mjs --production",
    "renderer:test": "node --test deployment/isolated-renderer/hosting.test.mjs",
    "worker-check:test": "tsc -p scripts/tsconfig.worker-check.json && vitest run --config scripts/vitest-worker-check.config.mjs",
    "player-check:build": "node scripts/build-isolated-player-check.mjs",
    "security-check:build": "tsc -b tsconfig.security-check.json && node scripts/build-isolated-security-check.mjs",
    "security-check:test": "node --test deployment/isolated-renderer/security-check-page.test.mjs deployment/isolated-renderer/player-check-server.test.mjs scripts/isolated-security-report.test.mjs && vitest run --config scripts/vitest-security-check.config.mjs"
  },
  "dependencies": {
    "@notrac/mage": "1.0.3",
    "lucide-react": "1.49.0",
    "patch-package": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.59.0",
    "@swc/core-linux-x64-gnu": "1.15.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
