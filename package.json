{
  "name": "mage-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "patch-package --error-on-fail && npm run icons:generate",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "postinstall": "patch-package --error-on-fail",
    "test": "vitest run",
    "preview": "vite preview",
    "prerenderer:build": "patch-package --error-on-fail",
    "renderer:build": "tsc -b && node scripts/build-isolated-renderer.mjs",
    "prerenderer:build:production": "patch-package --error-on-fail",
    "renderer:build:production": "tsc -b && node scripts/build-isolated-renderer.mjs --production",
    "renderer:serve": "node scripts/serve-isolated-renderer.mjs",
    "renderer:verify": "node scripts/verify-isolated-renderer.mjs",
    "renderer:verify:production": "node scripts/verify-isolated-renderer.mjs --production",
    "renderer:test": "node --test deployment/isolated-renderer/hosting.test.mjs",
    "player-check:build": "node scripts/build-isolated-player-check.mjs"
  },
  "dependencies": {
    "@notrac/mage": "1.0.3",
    "lucide-react": "1.49.0",
    "patch-package": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.59.0",
    "@swc/core-linux-x64-gnu": "1.15.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
