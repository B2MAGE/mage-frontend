{
  "policyVersion": 1,
  "description": "Whole-scene compilation limits for Scene Builder version 1, including composition version 1. Counts include arranged copies, object frames, every group and post-composition group modifiers. Procedural frame distance work and lattice coordinate folds use the modifier budget per arranged copy. Expression workload weights each noise evaluation as eight operations; structural node/depth limits are unchanged.",
  "limits": {
    "expandedPrimitives": 16,
    "compositionOperations": 15,
    "transformOperations": 200,
    "materialOperations": 72,
    "modifierOperations": 80,
    "arrangementOperations": 15,
    "animationOperations": 16,
    "liveUniforms": 64,
    "optionalEffects": 4,
    "generatedSourceBytes": 32768,
    "groups": 8,
    "groupDepth": 6,
    "driverOperations": 192,
    "authoredDrivers": 32
  },
  "operationCosts": {
    "sphere": 1,
    "box": 1,
    "torus": 1,
    "cylinder": 1,
    "transformPerObject": 5,
    "materialPerObject": 3,
    "expandModifier": 1,
    "shellModifier": 2,
    "twistModifier": 2,
    "arrangementPerAdditionalCopy": 1,
    "spinPerPrimitive": 1,
    "compositionPerAdditionalObject": 1,
    "liveUniformPerBinding": 1,
    "box-frame": 3,
    "lattice": 3,
    "latticePerFold": 1,
    "noise": 8
  },
  "driverLimits": {
    "perNode": 8,
    "expressionDepth": 8,
    "expressionNodes": 32,
    "constantMagnitude": 1000,
    "intermediateMagnitude": 1000000,
    "clockPeriod": 86400
  }
}
