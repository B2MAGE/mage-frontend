# Keep the existing Coolify /player-check proxy target until its route is removed.
# This image contains only a retirement responder, with no test assets or engine.
FROM node:24-bookworm-slim
WORKDIR /app
COPY deployment/isolated-renderer/player-check-server.mjs ./deployment/isolated-renderer/player-check-server.mjs
ENV NODE_ENV=production PORT=80
USER node
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["node", "-e", "require('node:http').get('http://127.0.0.1:80/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
CMD ["node", "deployment/isolated-renderer/player-check-server.mjs"]
