FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY patches ./patches
RUN npm ci
COPY scripts ./scripts
COPY deployment/isolated-renderer ./deployment/isolated-renderer
COPY tsconfig*.json ./
COPY src ./src
COPY contracts/scenes ./contracts/scenes
RUN npm run player-check:build && npm run security-check:build && npm run worker-check:page:build

FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=build /app/dist-player-check ./dist-player-check
COPY deployment/isolated-renderer/player-check-server.mjs deployment/isolated-renderer/live-check-page.mjs deployment/isolated-renderer/security-check-page.mjs deployment/isolated-renderer/worker-check-page.mjs ./deployment/isolated-renderer/
COPY scripts/isolated-security-config.mjs ./scripts/
ENV NODE_ENV=production PORT=80
USER node
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["node", "-e", "require('node:http').get('http://127.0.0.1:80/player-check/',{headers:{host:'mage.peterbucci.com'}},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
CMD ["node", "deployment/isolated-renderer/player-check-server.mjs"]
