FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY patches ./patches
RUN npm ci
COPY scripts/build-isolated-player-check.mjs ./scripts/
COPY deployment/isolated-renderer/live-check-page.mjs ./deployment/isolated-renderer/
COPY src/modules/player/isolation ./src/modules/player/isolation
COPY src/modules/player/policy ./src/modules/player/policy
COPY src/modules/player/templates ./src/modules/player/templates
COPY contracts/scenes ./contracts/scenes
RUN npm run player-check:build

FROM nginx:1.27-alpine
COPY deployment/isolated-renderer/nginx.player-check.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-player-check /usr/share/nginx/html/player-check
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
