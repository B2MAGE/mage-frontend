+			status: this._status, error: this.error, frame: fresh ? copyFrame(this.latest) : null,
+			queuedFrames: this.frames.length, droppedFrames: this.droppedFrames,
+		};
+	}
+	dispose() {
+		this.disconnect();
+		this._status = 'disposed';
+	}
+}
